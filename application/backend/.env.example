# Optional. The default file is ../data/pill.db, outside the reload watch path.
# DATABASE_URL=sqlite:////absolute/path/to/pill.db

# Comma-separated browser origins. Leave empty to allow localhost only.
# Set to * only for a temporary local experiment. Do not use * in production.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Official interaction API. Leave empty until a real source is available.
# Do not commit real keys. Put them in backend/.env, which is gitignored.
INTERACTION_API_BASE_URL=
INTERACTION_API_KEY=

# 식품의약품안전처 공공데이터 일반 인증키. 값은 backend/.env에만 넣습니다.
MFDS_SERVICE_KEY=
